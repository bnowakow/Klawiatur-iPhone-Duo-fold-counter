# Copy to .env to override Docker Compose defaults. Equal active times = all day.
STREAM_URL=https://www.youtube.com/watch?v=vaiHWiExDXg
INTERVAL_SECONDS=4
# Adaptive polling grows immediately on overruns; recover after 12 light cycles.
BACKPRESSURE_MAX_INTERVAL_SECONDS=60
BACKPRESSURE_STABLE_SAMPLES=12
POSTGRES_PASSWORD=folding-local-dev
POSTGRES_PORT=54329
# Initial range: published completed stints, 29.5–56.7 folds/minute / 60.
# Counter rates are folds/second. Recent accepted pace replaces this initial range.
EXPECTED_RATE_MIN=0.4916666666666667
EXPECTED_RATE_MAX=0.945
MAX_RATE=5
RATE_TOLERANCE=0.5
COUNTER_SLACK=5
REBASE_AFTER_SECONDS=600
CLOTHING_ROI=0.48,0.51,0.65,0.62
CLOTHING_THRESHOLD=0.45
HANDOVER_CONFIRM_SECONDS=60
# Night inactivity closes the stint provisionally after three minutes.
NIGHT_STOP_START=21:30
NIGHT_STOP_END=06:30
NIGHT_STOP_IDLE_SECONDS=180
TIMEZONE=Europe/Warsaw
ACTIVE_START=00:00
ACTIVE_END=00:00
# Image files under DATA_DIR: 20 GB total; evict oldest images after logging an error.
IMAGE_STORAGE_LIMIT_BYTES=20000000000

# Independent archive of public ipduotest.pl tables, chart and homepage.
OFFICIAL_DATA_INTERVAL_SECONDS=300

# Local vision model for one clothing description per folding stint.
CLOTHING_DESCRIPTION_MODEL=moondream:1.8b
